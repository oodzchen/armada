diff --git a/Documentation/ABI/testing/sysfs-driver-input-nt36536 b/Documentation/ABI/testing/sysfs-driver-input-nt36536
new file mode 100644
--- /dev/null
+++ b/Documentation/ABI/testing/sysfs-driver-input-nt36536
@@ -0,0 +1,18 @@
+What:		/sys/bus/spi/devices/spi<bus>.<cs>/pen_scan
+Date:		September 2026
+KernelVersion:	7.2
+Contact:	linux-input@vger.kernel.org
+Description:
+		Reading returns whether the NT36536 touchscreen controller
+		has been asked to scan for an active pen, 0 or 1.  Writing a
+		boolean turns pen scanning on or off.  The default is off:
+		scanning costs power and the controller does not report the
+		pen without it.  The setting survives the firmware reload
+		that follows every panel power up.
+
+		The attribute only exists when the devicetree declares
+		novatek,pen-support.
+
+		Access: Read, Write
+
+		Valid values: Boolean
diff --git a/Documentation/devicetree/bindings/input/oneplus,pad2pro-pogo-keyboard.yaml b/Documentation/devicetree/bindings/input/oneplus,pad2pro-pogo-keyboard.yaml
new file mode 100644
--- /dev/null
+++ b/Documentation/devicetree/bindings/input/oneplus,pad2pro-pogo-keyboard.yaml
@@ -0,0 +1,86 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/input/oneplus,pad2pro-pogo-keyboard.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: OnePlus Pad 2 Pro pogo pin keyboard
+
+maintainers:
+  - yzddmr6 <46088090+yzddmr6@users.noreply.github.com>
+
+description: |
+  The OnePlus Pad 2 Pro, and the OPPO Pad 4 Pro built on the same board,
+  accept a keyboard cover with a touchpad on a magnetic pogo pin connector.
+  The keyboard's microcontroller exchanges framed packets with the tablet
+  over one half-duplex data line: the transmit and receive pins of a tablet
+  UART meet on that line through a direction switch, which the tablet
+  enables only while it transmits, so the tablet receives its own
+  transmissions back as well.
+
+  The tablet switches the connector supply. While the supply is off, an
+  attached keyboard pulls a separate sense line low; the tablet samples that
+  line to decide when to power the connector, and learns from the silence of
+  the powered keyboard that it has been removed.
+
+  The touchpad coordinate range and resolution are fixed by the keyboard
+  firmware, identical for every keyboard this tablet accepts, and implied by
+  the compatible string; they are not board properties.
+
+allOf:
+  - $ref: /schemas/serial/serial-peripheral-props.yaml#
+
+properties:
+  compatible:
+    const: oneplus,pad2pro-pogo-keyboard
+
+  vdd-supply:
+    description: Switched supply of the pogo pin connector.
+
+  tx-enable-gpios:
+    maxItems: 1
+    description:
+      Direction switch of the data line. While asserted, the UART transmit
+      pin drives the line; while deasserted, the line belongs to the
+      keyboard.
+
+  detect-gpios:
+    maxItems: 1
+    description:
+      Attachment sense line, asserted while a keyboard is attached. Only
+      meaningful while vdd-supply is off.
+
+  interrupts:
+    maxItems: 1
+    description: Edge on the attachment sense line when a keyboard attaches.
+
+  wakeup-source: true
+
+  current-speed:
+    description: Line rate of the data line.
+    default: 921600
+
+required:
+  - compatible
+  - vdd-supply
+  - tx-enable-gpios
+  - detect-gpios
+  - interrupts
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    serial {
+        keyboard {
+            compatible = "oneplus,pad2pro-pogo-keyboard";
+            vdd-supply = <&pogo_vdd>;
+            tx-enable-gpios = <&tlmm 83 GPIO_ACTIVE_HIGH>;
+            detect-gpios = <&tlmm 96 GPIO_ACTIVE_LOW>;
+            interrupts-extended = <&tlmm 96 IRQ_TYPE_EDGE_FALLING>;
+            wakeup-source;
+        };
+    };
diff --git a/Documentation/devicetree/bindings/input/touchscreen/novatek,nt36536-ts.yaml b/Documentation/devicetree/bindings/input/touchscreen/novatek,nt36536-ts.yaml
new file mode 100644
--- /dev/null
+++ b/Documentation/devicetree/bindings/input/touchscreen/novatek,nt36536-ts.yaml
@@ -0,0 +1,87 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/input/touchscreen/novatek,nt36536-ts.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Novatek NT36536 touchscreen controller
+
+maintainers:
+  - yzddmr6 <46088090+yzddmr6@users.noreply.github.com>
+
+description:
+  The Novatek NT36536 is a touch and display driver integrated (TDDI)
+  controller. Its display half is a novatek,nt36536 panel on the DSI bus;
+  this binding describes its touch half, which is reached over SPI. The
+  touch half has no supply or reset line of its own and no flash for its
+  firmware. It is powered and reset together with the panel, and its
+  firmware has to be downloaded again every time the panel is powered up.
+  The panel node therefore owns the supplies and the reset line, and the
+  touchscreen refers to the panel it follows.
+
+allOf:
+  - $ref: touchscreen.yaml#
+  - $ref: /schemas/spi/spi-peripheral-props.yaml#
+
+properties:
+  compatible:
+    const: novatek,nt36536-ts
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  panel:
+    description:
+      The panel driven by the display half of the same controller.
+
+  firmware-name:
+    maxItems: 1
+    description:
+      Firmware image downloaded to the controller each time the panel is
+      powered up.
+
+  novatek,pen-support:
+    type: boolean
+    description:
+      The sensor and the controller firmware also track an active stylus.
+      The pen is reported in the same frame as touchscreen-size-x and
+      touchscreen-size-y describe, with the same axis swap and inversion.
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - panel
+  - touchscreen-size-x
+  - touchscreen-size-y
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    spi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        touchscreen@0 {
+            compatible = "novatek,nt36536-ts";
+            reg = <0>;
+            spi-max-frequency = <12000000>;
+            interrupt-parent = <&tlmm>;
+            interrupts = <162 IRQ_TYPE_EDGE_FALLING>;
+            panel = <&panel>;
+            firmware-name = "novatek/nt36536-xn242.bin";
+            novatek,pen-support;
+            touchscreen-size-x = <2400>;
+            touchscreen-size-y = <3392>;
+            touchscreen-swapped-x-y;
+            touchscreen-inverted-x;
+        };
+    };
+
+...
