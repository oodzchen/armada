+ * next full modeset, which never comes. Power-cycle and retry: a host-side
+ * fault keeps failing and is reported, a panel that missed the first
+ * sequence comes up on the next attempt.
+ */
+#define NT36536_PREPARE_ATTEMPTS 3
+
 static int novatek_nt36536_prepare(struct drm_panel *panel)
 {
 	struct novatek_nt36536 *ctx = to_novatek_nt36536(panel);
-	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi[1] };
-	int ret;
+	struct device *dev = &ctx->dsi[0]->dev;
+	int attempt, ret = 0;
 
-	ret = novatek_nt36536_power_on(ctx);
-	if (ret < 0)
-		return ret;
-
-	novatek_nt36536_reset(ctx);
-
-	/*
-	 * The stock sequence configures the panel's DSC decoder solely through
-	 * the vendor 0x91 blob in the on-commands; it never receives a DCS PPS
-	 * or a compression-mode packet. Sending the standard PPS afterwards
-	 * re-programmed the decoder with full-width (3392) semantics while each
-	 * DSI link only carries 1696 px, so the decoder starved -- black screen.
-	 */
-	ret = novatek_nt36536_on(ctx);
-	if (ret < 0)
-		goto err;
-
-	if (dsi_ctx.accum_err) {
-		ret = dsi_ctx.accum_err;
-		goto err;
+	for (attempt = 1; attempt <= NT36536_PREPARE_ATTEMPTS; attempt++) {
+		ret = novatek_nt36536_power_on(ctx);
+		if (ret < 0)
+			return ret;
+
+		novatek_nt36536_reset(ctx);
+
+		/*
+		 * The stock sequence configures the panel's DSC decoder solely
+		 * through the vendor 0x91 blob in the on-commands; it never
+		 * receives a DCS PPS or a compression-mode packet. Sending the
+		 * standard PPS afterwards re-programmed the decoder with
+		 * full-width (3392) semantics while each DSI link only carries
+		 * 1696 px, so the decoder starved -- black screen.
+		 */
+		ret = novatek_nt36536_on(ctx);
