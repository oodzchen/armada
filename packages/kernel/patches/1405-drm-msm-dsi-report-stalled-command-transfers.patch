+/* OPD2413 diagnostics: dump the bonded partner link of a stalled transfer. */
+void msm_dsi_manager_dump_other(int id)
+{
+	struct msm_dsi *other = dsi_mgr_get_other_dsi(id);
+
+	if (IS_BONDED_DSI() && other && other->host)
+		msm_dsi_host_dump_regs(other->host, "partner of stalled link");
+}
