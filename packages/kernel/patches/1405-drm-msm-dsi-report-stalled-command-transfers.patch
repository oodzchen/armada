+/* OPD2413 diagnostics: DSI link state when a command transfer stalls. */
+void msm_dsi_host_dump_regs(struct mipi_dsi_host *host, const char *why)
+{
+	struct msm_dsi_host *msm_host = to_msm_dsi_host(host);
+
+	if (!msm_host->power_on) {
+		pr_err("dsi%d %s: link powered off\n", msm_host->id, why);
+		return;
+	}
+	pr_err("dsi%d %s: ctrl=%08x status0=%08x intr=%08x fifo=%08x ack=%08x tmo=%08x clk=%08x dln0=%08x\n",
+	       msm_host->id, why,
+	       dsi_read(msm_host, REG_DSI_CTRL),
+	       dsi_read(msm_host, REG_DSI_STATUS0),
+	       dsi_read(msm_host, REG_DSI_INTR_CTRL),
+	       dsi_read(msm_host, REG_DSI_FIFO_STATUS),
+	       dsi_read(msm_host, REG_DSI_ACK_ERR_STATUS),
+	       dsi_read(msm_host, REG_DSI_TIMEOUT_STATUS),
+	       dsi_read(msm_host, REG_DSI_CLK_STATUS),
+	       dsi_read(msm_host, REG_DSI_DLN0_PHY_ERR));
+}
