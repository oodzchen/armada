 		cfg_hnd->ops->link_clk_set_rate(msm_host);
-		cfg_hnd->ops->link_clk_enable(msm_host);
+		ret = cfg_hnd->ops->link_clk_enable(msm_host);
+		if (ret)
+			/* OPD2413: a link that cannot clock stalls a bonded transfer. */
+			pr_err("dsi%d: link clocks failed to enable for transfer: %d\n",
