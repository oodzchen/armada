+/*
+ * TDM back ends take their slot layout, framing and per-codec bit clock
+ * inversion from the DAI link (dai-tdm-slot-*, dai-format, bitclock-inversion).
+ * The SoC provides the bit clock.
+ */
+static int sc8280xp_tdm_hw_params(struct snd_pcm_substream *substream,
+				  struct snd_pcm_hw_params *params)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+	struct qcom_snd_tdm_slot_cfg cpu_cfg;
+	struct qcom_snd_tdm_slot_cfg *codec_cfg __free(kfree) =
+		kcalloc(rtd->dai_link->num_codecs, sizeof(*codec_cfg), GFP_KERNEL);
+	unsigned int cpu_fmt = (rtd->dai_link->dai_fmt & ~SND_SOC_DAIFMT_CLOCK_PROVIDER_MASK) |
+		SND_SOC_DAIFMT_BP_FP;
+	unsigned int bclk_freq;
+	int ret;
+
+	if (!codec_cfg)
+		return -ENOMEM;
+	ret = qcom_snd_get_dai_tdm_slots(rtd, &cpu_cfg, codec_cfg);
+	if (ret)
+		return ret == -ENOENT ? 0 : ret;
+
+	if (!cpu_cfg.slots)
+		return 0;
+
+	ret = snd_soc_dai_set_fmt(cpu_dai, cpu_fmt);
+	if (ret)
+		return ret;
+
+	ret = qcom_snd_apply_dai_tdm_slots_cfg(rtd, &cpu_cfg, codec_cfg);
+	if (ret)
+		return ret;
+
+	bclk_freq = snd_soc_tdm_params_to_bclk(params, cpu_cfg.slot_width, cpu_cfg.slots, 1);
+	if (!bclk_freq)
+		return -EINVAL;
+
+	ret = snd_soc_dai_set_sysclk(cpu_dai, LPAIF_MI2S_BCLK, bclk_freq, SND_SOC_CLOCK_IN);
+	if (ret)
+		dev_err(rtd->dev, "%s: failed to set cpu sysclk: %d\n", __func__, ret);
+
+	return ret;
+}
