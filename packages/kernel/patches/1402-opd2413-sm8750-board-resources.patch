@@ -692,6 +717,13 @@
 		};
 	};
 
+	/*
+	 * The bootloader leaves an early SoCCP image running in D0 with no bus
+	 * vote of its own. The driver holds the SoCCP's path to DDR from probe
+	 * until the image it loads has parked itself in D3, as read from the
+	 * TCSR D-state register. Enabled for every board: without the firmware
+	 * the vote is simply kept, which is what lets the SoC wake from s2idle.
+	 */
 	remoteproc_soccp: remoteproc-soccp {
 		compatible = "qcom,sm8750-soccp-pas";
 
